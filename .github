   name: Update prices

   on:
     schedule:
       - cron: "17 10 * * *"
     workflow_dispatch:

   permissions:
     contents: write

   concurrency:
     group: update-prices
     cancel-in-progress: false

   jobs:
     scrape:
       runs-on: ubuntu-latest
       timeout-minutes: 30
       steps:
         - uses: actions/checkout@v4

         - uses: actions/setup-python@v5
           with:
             python-version: "3.12"

         - name: Install the browser
           run: |
             pip install playwright==1.47.0
             python -m playwright install --with-deps chromium

         - name: Get today's prices
           run: python scraper/scrape.py

         - name: Save the new prices
           run: |
             git config user.name "price-bot"
             git config user.email "price-bot@users.noreply.github.com"
             git add data
             git diff --cached --quiet && echo "No changes" && exit 0
             git commit -m "Prices for $(date -u +%Y-%m-%d)"
             git push
